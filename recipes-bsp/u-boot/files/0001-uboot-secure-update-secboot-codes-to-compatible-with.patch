+int get_env_keys()
+{
+
+	char *value = NULL;
+	/* the keys for secboot include: bl2_pubkey, bl31_pubkey, bl32_pubkey, bl33_pubkey and m7_pubkey,
+	 * in which, the bl2, bl31 and bl33 keys are required and the bl32 and m7 keys are optional,
+	 * moreover, for each key, it has a handle, which indicates the key catlog/slot to store the key.
+	 * the key format is:
+	 *     <key_name>:<handle_value>
+	 * by default, all the keys use same value and handle as bl2 key's.
+	 * Users can set their specific values.
+	*/
+
+	for (int i = 0; secboot_keys[i].type != INVALID_KEY; i++) {
+
+		/* get key configs, the config includes pubkey name and the related key handle, the delimiter is ":" */
+		value = env_get(secboot_keys[i].env_name);
+		if (!value || !(*value)) {
+			if (secboot_keys[i].req) {
+				printf("ERROR: the %s is required, but not found\n", secboot_keys[i].env_name);
+				return -ENOENT;
+			}
+			continue;
+		}
+		secboot_keys[i].config = value;
+	}
+
+	return 0;
+}
+
+int hse_parse_keys(void)
+{
+	char *handle_string = NULL;
+
+	for (int i = 0; secboot_keys[i].type != INVALID_KEY; i++) {
+		if (!secboot_keys[i].config)
+			continue;
+
+		if (!strchr(secboot_keys[i].config, ':')) {
+			secboot_keys[i].name = secboot_keys[i].config;
+			printf("\tSuccessfully parsed %s input\n", secboot_keys[i].name);
+			continue;
+		}
+
+		secboot_keys[i].name = strtok(strdup(secboot_keys[i].config), ":");
+
+		if (!secboot_keys[i].name)
+			return -EINVAL;
+
+		handle_string = strtok(NULL, ":");
+		if (!handle_string || strlen(handle_string) != 8)
+			return -EINVAL;
+
+		secboot_keys[i].handle = (uint32_t)simple_strtoul(handle_string, NULL, 16);
+		if (!secboot_keys[i].handle)
+			return -EINVAL;
+		printf("\tSuccessfully parsed %s input\n", secboot_keys[i].name);
+	}
+	return 0;
+}
+
+int hse_check_prev_import(int key_idx)
+{
+	for (int i = 0; i < key_idx; i++) {
+		if (secboot_keys[i].handle == secboot_keys[key_idx].handle) {
+			printf("\tKey slot already occupied, %s already imported for a previous BL\n",
+				 secboot_keys[key_idx].name);
+			return 1;
+		}
+	}
+	return 0;
+}
+
+int hse_extract_file(const char *file_name, uint8_t *buf, u32 *plen)
+{
+	uint8_t *tmp = NULL;
+	long long len_read;
+	char devpart[4];
+	loff_t ret = 0;
+
+	if (!file_name || !buf) {
+		printf("ERROR: param empty, please check it\n");
+		return -1;
+	}
+
+	snprintf(devpart, sizeof(devpart), "%s:%d", env_get("mmcdev"), MMC_ROOT_PARTITION);
+	ret = fs_set_blk_dev("mmc", devpart, FS_TYPE_EXT);
+	if (ret) {
+		printf("ERROR: could not set block device\n");
+	}
+
+	tmp = malloc(MAX_BIN_SIZE);
+	if (!tmp) {
+		printf("ERROR: could not allocate space for temporary buffer \n");
+		return -ENOMEM;;
+	}
+
+	ret = fs_read(file_name, (uintptr_t)tmp, 0, 0, &len_read);
+	if (ret < 0) {
+		printf("ERROR: could not read file %s\n", file_name);
+		goto out_free_tmp_buf;
+	}
+
+	memcpy(buf, tmp, len_read);
+	if (plen) {
+		*plen = len_read;
+	}
+
+out_free_tmp_buf:
+	free(tmp);
+
+	return ret;
+}
+
+void hse_init_secboot_bins(struct hse_private *priv)
+{
+
+	for (int i = BL2_BIN; i < MAX_BIN_INDEX; i++) {
+		priv->secboot_bins[i].type = i;
+		priv->secboot_bins[i].req = true;
+		priv->secboot_bins[i].name = NULL;
+		priv->secboot_bins[i].env_name = bin_env_name[i];
+		priv->secboot_bins[i].size = 0;
+		memset((void *)priv->secboot_bins[i].data, 0, sizeof(priv->secboot_bins[i].data));
+		memset((void *)priv->secboot_bins[i].signature, 0, sizeof(priv->secboot_bins[i].signature));
+	}
+
+	if (priv->ivt.boot_type < NXP_M7_SEC_BOOT) {
+		priv->secboot_bins[M7_BIN].req = false;
+	}
+}
+
+int get_env_bins(struct hse_private *priv)
+{
+	/* env bins include:
+	 * required: bl2_bin
+	 * optional: m7_bin
+	*/
+	int ret = 0;
+	char file_name[256];
+	char *tmp = NULL;
+	char *file_dir = SECBOOT_RESOURCE_DIR;
+	char *value = NULL;
+
+	for (int i = BL2_BIN; i < MAX_BIN_INDEX; i++) {
+
+		if (!priv->secboot_bins[i].req) {
+			continue;
+		}
+
+		value = env_get(priv->secboot_bins[i].env_name);
+		if (!value || !(*value)) {
+			printf("ERROR: get environment variable %s failed\n", priv->secboot_bins[i].env_name);
+			return -ENOENT;
+		}
+
+		/* get binary data */
+		snprintf(file_name, sizeof(file_name), "/%s/%s", file_dir, value);
+		ret = hse_extract_file(file_name, priv->secboot_bins[i].data, &priv->secboot_bins[i].size);
+		if (ret) {
+			printf("ERROR: extract data of %s failed\n", file_name);
+			return ret;
+		}
+
+		/* get binary signature */
+		tmp = file_name;
+		snprintf(file_name, sizeof(file_name), "%s.%s", tmp, "sign");
+		ret = hse_extract_file(file_name, priv->secboot_bins[i].signature, NULL);
+		if (ret) {
+			printf("ERROR: extract data of %s failed\n", file_name);
+			return ret;
+		}
+	}
+
+	return ret;
+}
